# Copy to /etc/photodash.env on the Pi (install.sh writes shell-quoted values).
# Admin password is set during install/migrate only — not stored in this file.
SECRET_KEY=change-me-to-a-long-random-string
PHOTODASH_DB_PATH=/var/lib/photodash/photodash.db
PHOTODASH_STORAGE_PATH=/mnt/usb/photodash/photos
PHOTODASH_FALLBACK_STORAGE_PATH=/var/lib/photodash/photos
PHOTODASH_HOST=0.0.0.0
PHOTODASH_PORT=8080
