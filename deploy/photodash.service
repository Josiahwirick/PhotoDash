[Unit]
Description=PhotoDash Flask application
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=photodash
Group=photodash
EnvironmentFile=-/etc/photodash.env
WorkingDirectory=/opt/photodash
ExecStart=/opt/photodash/.venv/bin/gunicorn \
  --bind 0.0.0.0:8080 \
  --workers 1 \
  --threads 4 \
  --timeout 60 \
  "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
