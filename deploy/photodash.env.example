# Installed to /etc/photodash.env by install.sh (values are shell-quoted).
# Admin password is set at install/migrate time only — not stored in this file.
SECRET_KEY=REPLACE_SECRET_KEY
PHOTODASH_DB_PATH=/var/lib/photodash/photodash.db
PHOTODASH_STORAGE_PATH=/mnt/usb/photodash/photos
PHOTODASH_FALLBACK_STORAGE_PATH=/var/lib/photodash/photos
PHOTODASH_HOST=0.0.0.0
PHOTODASH_PORT=8080
