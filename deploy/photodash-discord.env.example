# Discord bot companion for PhotoDash (not committed with secrets).
# Copy to /etc/photodash-discord.env and fill in values.
DISCORD_BOT_TOKEN=
# Optional: also accept messages in this guild text channel (snowflake ID)
DISCORD_CHANNEL_ID=
PHOTODASH_WEBHOOK_URL=http://127.0.0.1:8080/api/webhook
# Prefer matching Admin → Settings webhook token
PHOTODASH_WEBHOOK_TOKEN=
