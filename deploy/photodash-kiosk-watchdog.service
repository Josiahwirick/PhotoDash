[Unit]
Description=PhotoDash kiosk durability watchdog (Chromium / memory / CLIAMP)
After=photodash.service photodash-kiosk.service
Wants=photodash.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/photodash-kiosk-watchdog --daemon
Restart=always
RestartSec=10
Nice=-5
# Watchdog must keep running even when the Pi is under memory pressure.
OOMScoreAdjust=-900
MemoryMax=64M

[Install]
WantedBy=multi-user.target
