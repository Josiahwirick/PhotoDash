[Unit]
Description=PhotoDash Discord bot
After=photodash.service network-online.target
Wants=photodash.service network-online.target

[Service]
Type=simple
User=photodash
Group=photodash
EnvironmentFile=-/etc/photodash.env
EnvironmentFile=/etc/photodash-discord.env
WorkingDirectory=/opt/photodash/discord_bot
ExecStart=/opt/photodash/discord_bot/.venv/bin/python /opt/photodash/discord_bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
